# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ไม่ถูก commit ขึ้น git อยู่แล้ว)

# ค่าสุ่มยาว ๆ สำหรับเข้ารหัส session — ห้ามใช้ค่า default ในซอร์สโค้ดตอน deploy จริงเด็ดขาด
# สร้างได้ด้วยคำสั่ง: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ตั้งเป็น production ตอน deploy จริง (ทำให้ cookie บังคับส่งผ่าน HTTPS เท่านั้น)
NODE_ENV=development

# พอร์ตของเว็บหลักและระบบแอดมิน (ค่าเริ่มต้น 3000 / 4000 ถ้าไม่ตั้งค่า)
PORT=3000
ADMIN_PORT=4000

# โดเมนจริงของเว็บไซต์ (ใช้ทำ sitemap.xml และ SEO meta tags)
SITE_URL=https://www.yuyenpensuk.co.th

# โฟลเดอร์เก็บฐานข้อมูล (data/db.json) และไฟล์อัปโหลด — ถ้า deploy บน Render/Railway
# ที่มี persistent disk แยกต่างหาก ให้ชี้ไปที่ path ของ disk นั้น เช่น /data
DATA_DIR=
UPLOAD_DIR=
