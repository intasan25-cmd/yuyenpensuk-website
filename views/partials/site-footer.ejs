<footer class="foot">
  <div class="cols">
    <div>
      <% if (company.logo) { %><img src="<%= company.logo %>" style="height:40px;margin-bottom:10px" alt="<%= company.name %>"><% } %>
      <h4 style="color:#fff;font-family:var(--fd);font-size:17px;text-transform:none;letter-spacing:0"><%= company.name.replace(' (สำนักงานใหญ่)','') %></h4>
      <p style="font-size:12.5px;line-height:1.7;margin-top:8px">ติดตั้ง ล้าง ซ่อม และจำหน่ายเครื่องปรับอากาศทุกยี่ห้อ พร้อมงานไฟฟ้าที่เกี่ยวข้อง</p>
      <p style="font-size:12px;margin-top:8px;color:#7E9187"><iconify-icon icon="mdi:file-document-outline" style="margin-right:5px"></iconify-icon>เลขประจำตัวผู้เสียภาษี <%= company.tax_id %></p>
    </div>
    <div>
      <h4>เมนู</h4>
      <a href="/">หน้าแรก</a><a href="/services">บริการ</a><a href="/products">สินค้า</a><a href="/projects">ผลงาน</a>
    </div>
    <div>
      <h4>ค่าบริการ</h4>
      <a href="/pricing-install">ค่าติดตั้งแอร์</a><a href="/pricing-clean">ค่าล้างแอร์</a><a href="/payment">การชำระเงิน</a>
    </div>
    <div>
      <h4>ติดต่อ</h4>
      <a href="tel:<%= company.phone %>"><iconify-icon icon="mdi:phone-outline"></iconify-icon><%= company.phone %></a>
      <a href="mailto:<%= company.email %>"><iconify-icon icon="mdi:email-outline"></iconify-icon><%= company.email %></a>
      <a><iconify-icon icon="mdi:chat-outline"></iconify-icon>Line: <%= company.line %></a>
      <a><iconify-icon icon="mdi:clock-outline"></iconify-icon>จันทร์–เสาร์ 08:00–17:30</a>
    </div>
  </div>
  <div class="cp">
    <span>© 2569 <%= company.name.replace(' (สำนักงานใหญ่)','') %></span>
    <span>สงวนลิขสิทธิ์</span>
  </div>
</footer>
<script src="/js/main.js"></script>
